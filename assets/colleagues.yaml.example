# ============================================================================
# 研究方向 → 负责同学 名册 (colleagues roster)
# ----------------------------------------------------------------------------
# 用法：复制本文件为 colleagues.yaml，填入你们团队的真实信息。
# 每个 direction 的 keywords 用于自动匹配论文标题/摘要，命中越多分越高。
# 可选 priority 用于同分时明确指定优先级，数值越大越优先。
# owners 是收到该方向论文的同学（飞书 open_id，见 feishu_integration.md 获取）。
# 没有任何方向命中时，会 fallback 到 default_owner（可选，留空则提示人工处理）。
# 修改后运行：python scripts/validate_roster.py colleagues.yaml
# ============================================================================

directions:
  - name: "大语言模型 / LLM"
    keywords:
      - "LLM"
      - "large language model"
      - "GPT"
      - "instruction tuning"
      - "RLHF"
      - "prompt"
      - "预训练"
      - "chatbot"
    owners:
      - name: "张三"
        feishu_open_id: "ou_xxxxxxxxxxxx001"
        note: "预训练与对齐"

  - name: "计算机视觉 / CV"
    keywords:
      - "vision"
      - "image"
      - "detection"
      - "segmentation"
      - "diffusion"
      - "NeRF"
      - "视觉"
      - "目标检测"
    owners:
      - name: "李四"
        feishu_open_id: "ou_xxxxxxxxxxxx002"
      - name: "王五"
        feishu_open_id: "ou_xxxxxxxxxxxx003"

  - name: "强化学习 / RL"
    keywords:
      - "reinforcement learning"
      - "RL"
      - "policy gradient"
      - "MDP"
      - "actor-critic"
      - "强化学习"
    owners:
      - name: "赵六"
        feishu_open_id: "ou_xxxxxxxxxxxx004"

  - name: "多模态 / Multimodal"
    keywords:
      - "multimodal"
      - "vision-language"
      - "VLM"
      - "image-text"
      - "多模态"
    owners:
      - name: "钱七"
        feishu_open_id: "ou_xxxxxxxxxxxx005"

  - name: "图神经网络 / GNN"
    keywords:
      - "graph neural"
      - "GNN"
      - "node classification"
      - "knowledge graph"
      - "图神经网络"
    owners:
      - name: "孙八"
        feishu_open_id: "ou_xxxxxxxxxxxx006"

# 兜底负责人：没有任何方向命中时转发给 TA（可选，留空则提示人工处理）
default_owner:
  name: "组长"
  feishu_open_id: "ou_xxxxxxxxxxxx000"
