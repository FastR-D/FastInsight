# ============================================================================
# 研究方向 → 负责同学 名册 (colleagues roster)
# ----------------------------------------------------------------------------
# 历史格式示例，仅用于一次性导入；运行时不读取 YAML。
# 当前配置请在 FastResearch 工作台「论文分发设置」中维护。
# 每个 direction 的 keywords 用于自动匹配论文标题/摘要，命中越多分越高。
# 可选 priority 用于同分时明确指定优先级，数值越大越优先。
# owners.name 仅作显示；投递必须提供明确的 receiver_ref 收件账号 ID。
# 导入后请在设置页补全收件账号。feishu_open_id 可选，不用于投递。
# 没有任何方向命中时，会 fallback 到 default_owner（可选，留空则提示人工处理）。
# 一次性导入：uv run --locked python scripts/import_roster.py <旧配置路径>
# 读取数据库校验：uv run --locked python scripts/validate_roster.py
# ============================================================================

directions:
  - name: "大语言模型 / LLM"
    keywords:
      - "LLM"
      - "large language model"
      - "GPT"
      - "instruction tuning"
      - "RLHF"
      - "prompt"
      - "预训练"
      - "chatbot"
    owners:
      - name: "张三"
        feishu_open_id: "ou_xxxxxxxxxxxx001"
        note: "预训练与对齐"

  - name: "计算机视觉 / CV"
    keywords:
      - "vision"
      - "image"
      - "detection"
      - "segmentation"
      - "diffusion"
      - "NeRF"
      - "视觉"
      - "目标检测"
    owners:
      - name: "李四"
        feishu_open_id: "ou_xxxxxxxxxxxx002"
      - name: "王五"
        feishu_open_id: "ou_xxxxxxxxxxxx003"

  - name: "强化学习 / RL"
    keywords:
      - "reinforcement learning"
      - "RL"
      - "policy gradient"
      - "MDP"
      - "actor-critic"
      - "强化学习"
    owners:
      - name: "赵六"
        feishu_open_id: "ou_xxxxxxxxxxxx004"

  - name: "多模态 / Multimodal"
    keywords:
      - "multimodal"
      - "vision-language"
      - "VLM"
      - "image-text"
      - "多模态"
    owners:
      - name: "钱七"
        feishu_open_id: "ou_xxxxxxxxxxxx005"

  - name: "图神经网络 / GNN"
    keywords:
      - "graph neural"
      - "GNN"
      - "node classification"
      - "knowledge graph"
      - "图神经网络"
    owners:
      - name: "孙八"
        feishu_open_id: "ou_xxxxxxxxxxxx006"

# 兜底负责人：没有任何方向命中时转发给 TA（可选，留空则提示人工处理）
default_owner:
  name: "组长"
  feishu_open_id: "ou_xxxxxxxxxxxx000"
