# Feishu / Lark app (required)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Optional: skip /bot/v3/info lookup
# FEISHU_BOT_OPEN_ID=ou_xxxxxxxx

# FastResearch publish (required to complete /fastinsight)
FASTRESEARCH_URL=http://127.0.0.1:8787
FASTINSIGHT_INGEST_KEY=
# Routing is read from the FastResearch database; configure it in the workspace.
# For this legacy key, Research must set FASTRESEARCH_ALLOW_LEGACY_FASTINSIGHT_KEY=true.
# Alternatively clear FASTINSIGHT_INGEST_KEY and configure all three FastCAS values:
# FASTINSIGHT_FASTCAS_ISSUER=https://cas.example.com
# FASTINSIGHT_FASTCAS_CLIENT_ID=fastinsight
# FASTINSIGHT_FASTCAS_CLIENT_SECRET=
# FASTINSIGHT_FASTCAS_ALLOW_LOOPBACK_HTTP=true

# Optional LLM for screenshot understanding + 2-5 sentence trend analysis
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# VISION_MODEL=

# Optional academic / web-search enrichment (used by scripts/verify_paper.py)
# S2_API_KEY=
# CROSSREF_MAILTO=
# OPENALEX_MAILTO=
# SERPAPI_API_KEY=
# BING_SEARCH_API_KEY=
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_CX=

# Capture wait (seconds). Capture itself stays armed for 30 minutes.
# FASTINSIGHT_WAIT_TIMEOUT=180
