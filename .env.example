# Feishu / Lark app (required)
FEISHU_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_APP_SECRET=your-feishu-app-secret
# Optional: skip /bot/v3/info lookup
# FEISHU_BOT_OPEN_ID=ou_xxxxxxxx

# FastResearch publish (required to complete /fastinsight)
FASTRESEARCH_URL=http://127.0.0.1:8787
FASTINSIGHT_INGEST_KEY=your-service-ingest-key
FASTINSIGHT_ROSTER=assets/colleagues.yaml

# Optional LLM for screenshot understanding + 2-5 sentence trend analysis
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# VISION_MODEL=
# FASTINSIGHT_SEMANTIC_ROUTING_THRESHOLD=0.75

# Optional academic / web-search enrichment (used by scripts/verify_paper.py)
# S2_API_KEY=
# CROSSREF_MAILTO=
# OPENALEX_MAILTO=
# SERPAPI_API_KEY=
# BING_SEARCH_API_KEY=
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_CX=

# Capture wait (seconds). Capture itself stays armed for 30 minutes.
# FASTINSIGHT_WAIT_TIMEOUT=180
